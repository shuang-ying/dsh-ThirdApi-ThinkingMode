{
  "name": "dsh-api-thinking",
  "version": "0.1.0",
  "description": "DSH profile bundle: reads each third-party model's thinking levels from its own endpoint and keeps llm-pi-ai's reasoningEfforts in sync",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "tools",
    "test",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/sweep.test.mjs",
    "check": "node tools/check_live.mjs",
    "diff": "node tools/diff_gateway_profile.mjs",
    "install-bundle": "node tools/install_bundle.mjs",
    "prepack": "node test/sweep.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "reasoning-effort",
    "thinking",
    "openai-compatible"
  ],
  "license": "MIT",
  "author": "shuang-ying",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuang-ying/dsh-ThirdApi-ThinkingMode.git"
  },
  "homepage": "https://github.com/shuang-ying/dsh-ThirdApi-ThinkingMode#readme",
  "bugs": {
    "url": "https://github.com/shuang-ying/dsh-ThirdApi-ThinkingMode/issues"
  }
}
